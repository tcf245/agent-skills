#!/usr/bin/env bash
# keychain-secret — manage user secrets in macOS login Keychain (generic passwords)
# and audit them against the LLM Wiki Keychain Secrets Registry.
#
# Security model & why `security -w` is accepted:
#   - Secret values are NEVER accepted on argv (`add`/`rotate` read from a hidden TTY
#     prompt via `read -rs` or from stdin when piped) and NEVER printed by `info`/`audit`.
#   - Internally, this script invokes `security add-generic-password ... -w "$secret"`.
#     Passing `-w` to `security` briefly exposes the secret in local `ps` argv for the
#     sub-millisecond duration of the `security` child process. This is accepted on a
#     single-user Mac because macOS `security` has no non-interactive stdin flag for `-w`
#     combined with `-U` updates and `-j` comments, while this wrapper keeps secrets
#     out of shell history, agent transcripts, files, and logs.
set -euo pipefail

REGISTRY_DEFAULT="${KEYCHAIN_SECRET_REGISTRY:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/LLM-Wiki/wiki/records/Keychain Secrets Registry.md}"
REGISTRY_NAME="Keychain Secrets Registry"
TODAY="${KEYCHAIN_SECRET_TODAY:-$(date +%Y-%m-%d)}"

die() {
  printf 'keychain-secret: ERROR: %s\n' "$*" >&2
  exit 1
}

remind_registry() {
  local action="$1"
  printf '[keychain-secret] Reminder: update "%s" (%s) and log.md in the same session.\n' "$REGISTRY_NAME" "$action" >&2
}

 validate_date() {
  local d="$1"
  [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "invalid date '$d' (expected YYYY-MM-DD)"
}

read_secret_value() {
  local service="$1"
  local account="$2"
  local val=""
  if [ -t 0 ]; then
    printf 'Enter secret value for %s (%s): ' "$service" "$account" >&2
    IFS= read -rs val || true
    printf '\n' >&2
  else
    val="$(cat)"
  fi
  [ -n "$val" ] || die "empty secret value refused"
  printf '%s' "$val"
}

# Parse metadata from `security find-generic-password` output passed as $2.
# Modes:
#   field <raw> <acct|svce|icmt|cdat|mdat>
#   comment-build <raw> <created_default> <rotated_override> <expires_override> <note_override>
#   info-print <raw>
py_meta() {
  python3 - "$@" <<'PY'
import re
import sys

mode = sys.argv[1]
raw = sys.argv[2]

def extract_attr(text: str, key: str) -> str:
    if key == "svce":
        pat = re.compile(r'^\s*"svce"\s*<[^>]+>=(.*)$', re.MULTILINE)
    else:
        pat = re.compile(r'^\s*"' + re.escape(key) + r'"\s*<[^>]+>=(.*)$', re.MULTILINE)
    m = pat.search(text)
    if not m:
        return ""
    rhs = m.group(1).strip()
    if rhs == "<NULL>":
        return ""
    m_hex = re.match(r'^0x([0-9A-Fa-f]+)(?:\s+.*)?$', rhs)
    if m_hex:
        try:
            return bytes.fromhex(m_hex.group(1)).decode("utf-8", "replace").rstrip("\x00")
        except Exception:
            pass
    m_str = re.search(r'"((?:[^"\\]|\\.)*)"', rhs)
    if m_str:
        return m_str.group(1).replace(r'\000', '').rstrip("\x00")
    return rhs

def parse_comment(icmt: str) -> dict:
    out = {}
    for part in icmt.split(";"):
        part = part.strip()
        if "=" in part:
            k, v = part.split("=", 1)
            out[k.strip()] = v.strip()
    return out

def format_comment(meta: dict) -> str:
    ordered = []
    for k in ("created", "rotated", "expires", "note"):
        v = meta.get(k, "")
        if v:
            ordered.append(f"{k}={v.replace(';', ',')}")
    reg = meta.get("registry") or "Keychain Secrets Registry"
    ordered.append(f"registry={reg}")
    return ";".join(ordered)

if mode == "field":
    print(extract_attr(raw, sys.argv[3]))
elif mode == "comment-build":
    created_def, rotated_ovr, expires_ovr, note_ovr = sys.argv[3:7]
    meta = parse_comment(extract_attr(raw, "icmt"))
    if not meta.get("created") and created_def:
        meta["created"] = created_def
    if rotated_ovr:
        meta["rotated"] = rotated_ovr
    if expires_ovr:
        meta["expires"] = None if expires_ovr == "-" else expires_ovr
    if note_ovr:
        meta["note"] = note_ovr
    print(format_comment(meta))
elif mode == "info-print":
    svce = extract_attr(raw, "svce")
    acct = extract_attr(raw, "acct")
    icmt = extract_attr(raw, "icmt")
    cdat = extract_attr(raw, "cdat")
    mdat = extract_attr(raw, "mdat")
    meta = parse_comment(icmt)
    print(f"service:  {svce}")
    print(f"account:  {acct}")
    print(f"comment:  {icmt or '—'}")
    print(f"created:  {meta.get('created', '—')}")
    print(f"rotated:  {meta.get('rotated', '—')}")
    print(f"expires:  {meta.get('expires', '—')}")
    if meta.get("note"):
        print(f"note:     {meta['note']}")
    print(f"kc_cdat:  {cdat or '—'}")
    print(f"kc_mdat:  {mdat or '—'}")
PY
}

usage() {
  cat <<'EOF'
Usage:
  keychain-secret get <service> [account]
      Print secret value to stdout only (for `export X="$(keychain-secret get ...)"`).

  keychain-secret add <service> <account> [--expires YYYY-MM-DD] [--note TEXT]
      Add a new generic-password item (refuses if it already exists).
      Reads the secret via hidden prompt (`read -s`) on a TTY or from stdin when piped.

  keychain-secret rotate <service> [account] [--expires YYYY-MM-DD] [--note TEXT]
      Update an existing item's secret (`-U`), set rotated=today, keep created date.

  keychain-secret expire <service> [account] <YYYY-MM-DD>
      Update only the comment's `expires=YYYY-MM-DD` (re-stores current value internally).

  keychain-secret info <service> [account]
      Show service, account, comment metadata, and Keychain dates (NEVER the secret value).

  keychain-secret retire <service> [account] [--yes]
      Delete an item from Keychain. Without `--yes`, prints what would be deleted.

  keychain-secret audit [--registry PATH]
      Compare Keychain generic-password items against the wiki registry tables:
        1. Keychain items not in the registry (excluding App-managed & system items)
        2. Registry rows missing from Keychain
        3. Entries expired or expiring within 30 days
      Outputs names only, never secret values.

  keychain-secret --help
      Show this help message.
EOF
}

find_meta() {
  local service="$1"
  local account="${2:-}"
  if [ -n "$account" ]; then
    security find-generic-password -s "$service" -a "$account" 2>/dev/null
  else
    security find-generic-password -s "$service" 2>/dev/null
  fi
}

# Print the secret as plain text. `security -w` prints the value as hex when it
# holds any non-printable or non-ASCII byte (e.g. Chinese in a JSON blob); `-g`
# then reports `password: 0x<HEX> ...` on stderr, which is the reliable signal to
# decode. A plain ASCII secret that merely looks like hex is left untouched.
read_secret() {
  local service="$1" account="${2:-}"
  local args=(-s "$service")
  [ -n "$account" ] && args+=(-a "$account")
  local raw g
  raw="$(security find-generic-password "${args[@]}" -w)" || return $?
  g="$(security find-generic-password "${args[@]}" -g 2>&1 >/dev/null)" || true
  if printf '%s\n' "$g" | grep -q '^password: 0x'; then
    printf '%s' "$raw" | xxd -r -p
    printf '\n'
  else
    printf '%s\n' "$raw"
  fi
}

cmd_get() {
  [ $# -ge 1 ] && [ $# -le 2 ] || die "usage: keychain-secret get <service> [account]"
  read_secret "$1" "${2:-}"
}

cmd_add() {
  local service="" account="" expires="" note=""
  local pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires)
        [ $# -ge 2 ] || die "--expires requires YYYY-MM-DD"
        expires="$2"
        validate_date "$expires"
        shift 2
        ;;
      --note)
        [ $# -ge 2 ] || die "--note requires TEXT"
        note="$2"
        shift 2
        ;;
      --*)
        die "unknown option for add: $1"
        ;;
      *)
        pos+=("$1")
        shift
        ;;
    esac
  done
  [ "${#pos[@]}" -eq 2 ] || die "usage: keychain-secret add <service> <account> [--expires YYYY-MM-DD] [--note TEXT] (secret must not be passed on argv)"
  service="${pos[0]}"
  account="${pos[1]}"

  if security find-generic-password -s "$service" -a "$account" >/dev/null 2>&1; then
    die "item already exists for service='$service' account='$account'; use 'rotate' instead"
  fi

  local secret comment
  secret="$(read_secret_value "$service" "$account")"
  comment="$(py_meta comment-build "" "$TODAY" "" "$expires" "$note")"

  security add-generic-password -s "$service" -a "$account" -j "$comment" -w "$secret" >/dev/null
  printf '[keychain-secret] Added service=%s account=%s (%s)\n' "$service" "$account" "$comment" >&2
  remind_registry "add row for $service / $account"
}

cmd_rotate() {
  local service="" account="" expires="" note=""
  local pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires)
        [ $# -ge 2 ] || die "--expires requires YYYY-MM-DD"
        expires="$2"
        validate_date "$expires"
        shift 2
        ;;
      --note)
        [ $# -ge 2 ] || die "--note requires TEXT"
        note="$2"
        shift 2
        ;;
      --*)
        die "unknown option for rotate: $1"
        ;;
      *)
        pos+=("$1")
        shift
        ;;
    esac
  done
  [ "${#pos[@]}" -ge 1 ] && [ "${#pos[@]}" -le 2 ] || die "usage: keychain-secret rotate <service> [account] [--expires YYYY-MM-DD]"
  service="${pos[0]}"
  account="${pos[1]:-}"

  local meta_out resolved_account secret comment
  meta_out="$(find_meta "$service" "$account")" || die "item not found for service='$service'${account:+ account='$account'}; use 'add' instead"
  resolved_account="${account:-$(py_meta field "$meta_out" acct)}"
  [ -n "$resolved_account" ] || die "could not resolve account for service='$service'"

  secret="$(read_secret_value "$service" "$resolved_account")"
  comment="$(py_meta comment-build "$meta_out" "$TODAY" "$TODAY" "$expires" "$note")"

  security add-generic-password -U -s "$service" -a "$resolved_account" -j "$comment" -w "$secret" >/dev/null
  printf '[keychain-secret] Rotated service=%s account=%s (%s)\n' "$service" "$resolved_account" "$comment" >&2
  remind_registry "update Rotated=${TODAY}${expires:+ and Expires=${expires}} for $service / $resolved_account"
}

cmd_expire() {
  local service="" account="" expires=""
  local pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires)
        [ $# -ge 2 ] || die "--expires requires YYYY-MM-DD"
        expires="$2"
        shift 2
        ;;
      --*)
        die "unknown option for expire: $1"
        ;;
      *)
        pos+=("$1")
        shift
        ;;
    esac
  done

  if [ -n "$expires" ]; then
    [ "${#pos[@]}" -ge 1 ] && [ "${#pos[@]}" -le 2 ] || die "usage: keychain-secret expire <service> [account] <YYYY-MM-DD>"
    service="${pos[0]}"
    account="${pos[1]:-}"
  else
    if [ "${#pos[@]}" -eq 2 ]; then
      service="${pos[0]}"
      expires="${pos[1]}"
    elif [ "${#pos[@]}" -eq 3 ]; then
      service="${pos[0]}"
      account="${pos[1]}"
      expires="${pos[2]}"
    else
      die "usage: keychain-secret expire <service> [account] <YYYY-MM-DD>"
    fi
  fi
  validate_date "$expires"

  local meta_out resolved_account current_secret comment
  meta_out="$(find_meta "$service" "$account")" || die "item not found for service='$service'${account:+ account='$account'}"
  resolved_account="${account:-$(py_meta field "$meta_out" acct)}"
  [ -n "$resolved_account" ] || die "could not resolve account for service='$service'"

  current_secret="$(read_secret "$service" "$resolved_account")"
  comment="$(py_meta comment-build "$meta_out" "" "" "$expires" "")"

  security add-generic-password -U -s "$service" -a "$resolved_account" -j "$comment" -w "$current_secret" >/dev/null
  printf '[keychain-secret] Updated expiry for service=%s account=%s (%s)\n' "$service" "$resolved_account" "$comment" >&2
  remind_registry "update Expires=${expires} for $service / $resolved_account"
}

cmd_info() {
  [ $# -ge 1 ] && [ $# -le 2 ] || die "usage: keychain-secret info <service> [account]"
  local service="$1"
  local account="${2:-}"
  local meta_out
  meta_out="$(find_meta "$service" "$account")" || die "item not found for service='$service'${account:+ account='$account'}"
  py_meta info-print "$meta_out"
}

cmd_retire() {
  local service="" account="" confirm="no"
  local pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes)
        confirm="yes"
        shift
        ;;
      --*)
        die "unknown option for retire: $1"
        ;;
      *)
        pos+=("$1")
        shift
        ;;
    esac
  done
  [ "${#pos[@]}" -ge 1 ] && [ "${#pos[@]}" -le 2 ] || die "usage: keychain-secret retire <service> [account] [--yes]"
  service="${pos[0]}"
  account="${pos[1]:-}"

  local meta_out resolved_account icmt
  meta_out="$(find_meta "$service" "$account")" || die "item not found for service='$service'${account:+ account='$account'}"
  resolved_account="${account:-$(py_meta field "$meta_out" acct)}"
  icmt="$(py_meta field "$meta_out" icmt)"

  if [ "$confirm" != "yes" ]; then
    printf 'Would delete Keychain generic-password: service=%s account=%s comment="%s"\n' "$service" "$resolved_account" "${icmt:-—}"
    printf '[keychain-secret] Dry-run only. Re-run with --yes after explicit owner confirmation, then move row to Retired in "%s".\n' "$REGISTRY_NAME" >&2
    return 0
  fi

  security delete-generic-password -s "$service" -a "$resolved_account" >/dev/null
  printf '[keychain-secret] Deleted service=%s account=%s from Keychain.\n' "$service" "$resolved_account" >&2
  remind_registry "move $service / $resolved_account to Retired table with Retired on=${TODAY} and reason"
}

cmd_audit() {
  local registry="$REGISTRY_DEFAULT"
  while [ $# -gt 0 ]; do
    case "$1" in
      --registry)
        [ $# -ge 2 ] || die "--registry requires PATH"
        registry="$2"
        shift 2
        ;;
      --*)
        die "unknown option for audit: $1"
        ;;
      *)
        die "unexpected argument for audit: $1"
        ;;
    esac
  done

  [ -f "$registry" ] || die "registry file not found: $registry"

  python3 - "$registry" "$TODAY" <<'PY'
import datetime as dt
import fnmatch
import pathlib
import re
import subprocess
import sys

registry_path = pathlib.Path(sys.argv[1])
today = dt.date.fromisoformat(sys.argv[2])
dump_text = subprocess.run(["security", "dump-keychain"], capture_output=True, text=True, errors="replace").stdout
reg_text = registry_path.read_text(encoding="utf-8")

def extract_attr(block: str, key: str) -> str:
    if key == "svce":
        pat = re.compile(r'^\s*"svce"\s*<[^>]+>=(.*)$', re.MULTILINE)
    else:
        pat = re.compile(r'^\s*"' + re.escape(key) + r'"\s*<[^>]+>=(.*)$', re.MULTILINE)
    m = pat.search(block)
    if not m:
        return ""
    rhs = m.group(1).strip()
    if rhs == "<NULL>":
        return ""
    m_hex = re.match(r'^0x([0-9A-Fa-f]+)(?:\s+.*)?$', rhs)
    if m_hex:
        try:
            return bytes.fromhex(m_hex.group(1)).decode("utf-8", "replace").rstrip("\x00")
        except Exception:
            pass
    m_str = re.search(r'"((?:[^"\\]|\\.)*)"', rhs)
    if m_str:
        return m_str.group(1).replace(r'\000', '').rstrip("\x00")
    return rhs

def parse_comment(icmt: str) -> dict:
    out = {}
    for part in icmt.split(";"):
        part = part.strip()
        if "=" in part:
            k, v = part.split("=", 1)
            out[k.strip()] = v.strip()
    return out

# 1. Parse `security dump-keychain` generic-password (`class: "genp"`) items
kc_items = {}  # (service, account) -> dict(comment_meta)
chunks = re.split(r'(?=^keychain:\s*)', dump_text, flags=re.MULTILINE)
for chunk in chunks:
    if not re.search(r'^\s*class:\s*"genp"', chunk, re.MULTILINE):
        continue
    svce = extract_attr(chunk, "svce")
    acct = extract_attr(chunk, "acct")
    icmt = extract_attr(chunk, "icmt")
    if svce:
        kc_items[(svce, acct)] = parse_comment(icmt)

# 2. Parse markdown tables in Keychain Secrets Registry.md
user_rows = {}       # (service, account) -> {"expires": str, "status": str}
app_patterns = []    # list of (service_pat, account_pat)
retired_rows = set() # set of (service, account)

section = "main"
headers = None

def clean_cell(c: str) -> str:
    c = c.strip()
    if c.startswith("`") and c.endswith("`") and len(c) >= 2:
        c = c[1:-1].strip()
    return c

for line in reg_text.splitlines():
    m_sec = re.match(r'^##+\s+(.*)$', line.strip())
    if m_sec:
        h = m_sec.group(1).lower()
        if "app-managed" in h:
            section = "app"
        elif "retired" in h:
            section = "retired"
        else:
            section = "main"
        headers = None
        continue

    s = line.strip()
    if not (s.startswith("|") and s.endswith("|")):
        headers = None
        continue

    cells = [clean_cell(c) for c in s.strip("|").split("|")]
    if all(re.match(r'^:?-{2,}:?$', c.replace(" ", "")) for c in cells if c):
        continue

    lower_cells = [c.lower() for c in cells]
    if headers is None and "service" in lower_cells and "account" in lower_cells:
        headers = lower_cells
        continue

    if not headers or len(cells) < len(headers):
        continue

    row = dict(zip(headers, cells))
    svce = row.get("service", "")
    acct = row.get("account", "")
    if not svce:
        continue

    if section == "app":
        acct_pat = "*" if acct in ("", "*", "—", "-") else acct
        app_patterns.append((svce, acct_pat))
    elif section == "retired" or "retired on" in headers:
        retired_rows.add((svce, acct))
    else:
        user_rows[(svce, acct)] = {
            "expires": row.get("expires", ""),
            "status": row.get("status", "active"),
        }

SYSTEM_SERVICE_PATTERNS = [
    "* Safe Storage",
    "*Safe Storage*",
    "com.apple.*",
    "Apple *",
    "AppleID*",
    "iCloud*",
    "AirPort*",
    "Safari*",
    "Chrome*",
    "Keychain*",
    "handoff*",
    "ids:*",
    "ProtectedCloudStorage*",
    "continuity*",
    "HomeKit*",
    "FindMy*",
    "LocalItems*",
    "NetworkExtension*",
    "System*",
    "ksadmin*",
    "lockdown*",
    "CallHistory*",
    "Messages*",
    "FaceTime*",
    "CloudKit*",
    " Rapport*",
    "rapport*",
    "routined*",
    "searchparty*",
    "sharing*",
    "shortcuts*",
    " symptoms*",
    "uar*",
    "BeaconStore*",
    "ContextStore*",
    "CoreRoutine*",
    " Duet*",
    "dmd*",
    "familycircle*",
    "knowledge-agent*",
    "locationd*",
    "nsurlsessiond*",
    "parssec*",
    "siri*",
    "studentd*",
    "SyncedDefaults*",
    "Transparency*",
    "WiFi*",
]

# The login keychain also holds hundreds of system, Wi-Fi, Bluetooth and app items. Only items that look like ours
# can be "unregistered": made by this tool (comment has registry=), or named like our keys.
USER_NAME = re.compile(r"/|(^|[-_.])(api|key|token|secret|password|url|codes?)([-_.]|$)|^codex\.|^passport", re.IGNORECASE)

def looks_user_managed(svce: str, meta: dict) -> bool:
    return "registry" in meta or bool(USER_NAME.search(svce))

def is_ignored_kc_item(svce: str, acct: str) -> bool:
    for s_pat, a_pat in app_patterns:
        if fnmatch.fnmatchcase(svce, s_pat) and (a_pat == "*" or fnmatch.fnmatchcase(acct, a_pat)):
            return True
    for pat in SYSTEM_SERVICE_PATTERNS:
        if fnmatch.fnmatch(svce.lower(), pat.lower()):
            return True
    return False

# Category 1: In Keychain but not in registry
unregistered = []
for (svce, acct) in sorted(kc_items):
    if (svce, acct) in user_rows:
        continue
    if is_ignored_kc_item(svce, acct) or not looks_user_managed(svce, kc_items[(svce, acct)]):
        continue
    unregistered.append((svce, acct))

# Category 2: In registry (user-managed) but missing from Keychain
missing = []
for (svce, acct) in sorted(user_rows):
    if (svce, acct) not in kc_items:
        missing.append((svce, acct))

# Category 3: Expired or expiring within 30 days (from Keychain comment or registry Expires column)
expiring = []
seen_exp = {}
for (svce, acct), meta in kc_items.items():
    if is_ignored_kc_item(svce, acct) and (svce, acct) not in user_rows:
        continue
    exp_str = meta.get("expires", "")
    if re.match(r'^[0-9]{4}-[0-9]{2}-[0-9]{2}$', exp_str):
        seen_exp[(svce, acct)] = exp_str

for (svce, acct), info in user_rows.items():
    exp_str = info.get("expires", "")
    if re.match(r'^[0-9]{4}-[0-9]{2}-[0-9]{2}$', exp_str) and (svce, acct) not in seen_exp:
        seen_exp[(svce, acct)] = exp_str

for (svce, acct), exp_str in sorted(seen_exp.items()):
    try:
        exp_date = dt.date.fromisoformat(exp_str)
    except ValueError:
        continue
    delta = (exp_date - today).days
    if delta < 0:
        expiring.append((svce, acct, f"expired on {exp_str} ({-delta}d ago)"))
    elif delta <= 30:
        expiring.append((svce, acct, f"expires on {exp_str} (in {delta}d)"))

print("=== Keychain Secrets Audit ===")
print(f"Unregistered in Keychain ({len(unregistered)}):")
if unregistered:
    for svce, acct in unregistered:
        print(f"  - {svce} ({acct})")
else:
    print("  (none)")

print(f"\nMissing from Keychain ({len(missing)}):")
if missing:
    for svce, acct in missing:
        print(f"  - {svce} ({acct})")
else:
    print("  (none)")

print(f"\nExpired or expiring within 30 days ({len(expiring)}):")
if expiring:
    for svce, acct, status in expiring:
        print(f"  - {svce} ({acct}): {status}")
else:
    print("  (none)")
PY
}

main() {
  local sub="${1:---help}"
  shift || true
  case "$sub" in
    get)             cmd_get "$@" ;;
    add)             cmd_add "$@" ;;
    rotate)          cmd_rotate "$@" ;;
    expire)          cmd_expire "$@" ;;
    info)            cmd_info "$@" ;;
    retire)          cmd_retire "$@" ;;
    audit)           cmd_audit "$@" ;;
    -h|--help|help)  usage ;;
    *)               die "unknown subcommand '$sub' (see 'keychain-secret --help')" ;;
  esac
}

main "$@"
